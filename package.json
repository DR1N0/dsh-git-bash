{
  "name": "@dr1n0/dsh-git-bash",
  "version": "0.2.2-r2",
  "description": "Use Git for Windows Bash as the default DSH shell with restricted-mode support (community continuation of inmny/dsh-git-bash)",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "git-bash",
    "gitbash",
    "sandbox",
    "windows",
    "msys2"
  ],
  "homepage": "https://github.com/DR1N0/dsh-git-bash#readme",
  "bugs": {
    "url": "https://github.com/DR1N0/dsh-git-bash/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DR1N0/dsh-git-bash.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./agents": {
      "types": "./lib/agents.d.ts",
      "default": "./lib/agents.js"
    },
    "./discovery": {
      "types": "./lib/discovery.d.ts",
      "default": "./lib/discovery.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "native/bin/win32-x64/msys-token-guard.exe",
    "native/bin/win32-x64/msys-token-guard-hook.dll",
    "native/CMakeLists.txt",
    "native/*.cpp",
    "native/vendor/detours",
    "scripts/build-native.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build:native": "node scripts/build-native.mjs",
    "build:ts": "pnpm run clean && tsc -p tsconfig.json",
    "build": "pnpm run build:native && pnpm run build:ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test",
    "test:ts": "pnpm run build:ts && node --test",
    "pack:check": "npm pack --dry-run",
    "prepack": "pnpm run build:ts",
    "prepublishOnly": "pnpm run build:ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-bash-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-windows-acl": "0.2.2-rc.1",
    "@deepseek-ai/dsh-shell": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-timeout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@types/node": "24.10.1",
    "semver": "^7.8.5",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.28.5"
}
